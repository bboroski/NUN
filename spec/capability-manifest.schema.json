{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nun:capability-manifest:1",
  "title": "NUN Capability Manifest",
  "description": "Versioned declaration for a capability admitted to the NUN composition system.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "id",
    "version",
    "kind",
    "abi",
    "provides",
    "permissions",
    "artifact"
  ],
  "properties": {
    "manifest_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\\\.[a-z0-9-]+)+$",
      "description": "Stable reverse-domain identifier, for example nun.storage.cache."
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\\\.(0|[1-9][0-9]*)\\\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\\\+[0-9A-Za-z.-]+)?$"
    },
    "kind": {
      "enum": [
        "service",
        "driver",
        "library",
        "language",
        "adapter",
        "composite"
      ]
    },
    "abi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "major",
        "minor"
      ],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
        },
        "major": {
          "type": "integer",
          "minimum": 0
        },
        "minor": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "provides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "interface",
          "version"
        ],
        "properties": {
          "interface": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(\\\\.[a-z0-9-]+)+$"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\\\.(0|[1-9][0-9]*)\\\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\\\+[0-9A-Za-z.-]+)?$"
          }
        }
      }
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "interface",
          "version_range"
        ],
        "properties": {
          "interface": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(\\\\.[a-z0-9-]+)+$"
          },
          "version_range": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version_range"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(\\\\.[a-z0-9-]+)+$"
          },
          "version_range": {
            "type": "string",
            "minLength": 1
          },
          "optional": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "scope"
        ],
        "properties": {
          "operation": {
            "enum": [
              "memory.read",
              "memory.write",
              "device.discover",
              "device.access",
              "ipc.publish",
              "ipc.subscribe",
              "process.spawn",
              "filesystem.read",
              "filesystem.write",
              "network.connect",
              "network.listen"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "digest"
      ],
      "properties": {
        "format": {
          "enum": [
            "declarative",
            "wasm",
            "elf",
            "pe",
            "archive",
            "source"
          ]
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "origin": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "key_id",
            "value"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "minLength": 1
            },
            "key_id": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "children",
        "conflict_policy"
      ],
      "properties": {
        "children": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(\\\\.[a-z0-9-]+)+$"
          }
        },
        "conflict_policy": {
          "enum": [
            "reject",
            "namespace",
            "adapter",
            "prefer-explicit"
          ]
        },
        "preferred_providers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "memory_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "cpu_time_ms": {
          "type": "integer",
          "minimum": 0
        },
        "handle_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "composite"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "composition"
        ]
      }
    }
  ]
}
